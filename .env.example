# Copy to .env before `docker compose up --build -d`.
# Compose reads .env; native Python only reads variables exported in your shell.
# Never commit the filled .env. No key is needed to open the UI or saved examples.

# Browser: http://localhost:8765. Change this if that host port is occupied.
REVIEWER_LAB_PORT=8765

# Optional DeepSeek API key. Add a real key only to your private .env.
# API requests use your DeepSeek balance; starting the container makes no calls.
DEEPSEEK_API_KEY=

# Optional Claude authentication. Usually leave both empty and run:
# docker compose exec reviewer-lab claude auth login
# Choose EITHER an Anthropic API key OR a Claude Code OAuth token if using env auth.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Codex uses ChatGPT login, not an API key:
# docker compose exec reviewer-lab codex login --device-auth
# Both CLI logins persist in the lab-home Docker volume, separate from host auth.

# Advanced native Python options; Compose sets its own container interface/mode.
# Live native UI: python3 run.py start --live
REVIEWER_LAB_BIND=127.0.0.1
REVIEWER_LAB_DEMO=0
# Empty = http://127.0.0.1:<port> and http://localhost:<port>.
REVIEWER_LAB_PUBLIC_ORIGINS=
# Empty = CLI from PATH, or the bundled macOS Codex when available.
REVIEWER_LAB_CODEX=
REVIEWER_LAB_CLAUDE=
