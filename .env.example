# Docker Compose reads .env automatically. No API key is needed for the demo.
# Host port in compose; listening port when exported for native Python.
REVIEWER_LAB_PORT=8765

# Advanced native `ui` command: export these or pass matching CLI flags.
# Simple `start` always uses loopback. --live opens the experiment launch screen.
# Native demo can enable live explicitly through the local UI; Compose cannot.
# Compose explicitly sets its internal bind, port and demo mode.
REVIEWER_LAB_BIND=127.0.0.1
REVIEWER_LAB_DEMO=1
# Empty = exact http://127.0.0.1:<port> and http://localhost:<port> origins.
# Comma-separated explicit origins replace defaults, without trailing slashes.
REVIEWER_LAB_PUBLIC_ORIGINS=

# Optional native live mode only: absolute path to an installed Codex CLI.
# Empty = bundled macOS CLI when available, otherwise codex from PATH.
# Authenticate with that CLI; never put login tokens or credentials in this file.
REVIEWER_LAB_CODEX=

# Optional Claude Code CLI binary. Empty = claude from PATH / native install.
# Authenticate separately with claude auth login. Credentials stay managed by CLI.
REVIEWER_LAB_CLAUDE=

# DeepSeek: export DEEPSEEK_API_KEY in the terminal BEFORE starting native Python.
# Do not put a real key in this tracked template. The browser never needs the key.
# See docs/START.md for hidden input without putting a secret into shell history.
# Native Python does NOT load .env. Compose demo does NOT receive this secret.

# The Python process does not load .env by itself. Compose uses only PORT above;
# native Python reads exported environment variables. CODEX_HOME, if exported,
# is passed to the CLI as its standard config/login directory (not a secret).
# CODEX_HOME=/absolute/path/to/your/local/codex-config
